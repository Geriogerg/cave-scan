# Copier en .env et remplir. Ne jamais versionner .env.
# run_v0.py lit ce fichier au démarrage (via python-dotenv).

# --- Backend GRATUIT (défaut) : Gemini -------------------------------------
# Clé à créer sur https://aistudio.google.com/apikey
# Palier gratuit : modèles Flash uniquement, ~15 requêtes/minute.
# ATTENTION : en palier gratuit, Google peut exploiter les données envoyées.
# À trancher avec la maison de vente avant d'y envoyer les photos de ses lots.
GEMINI_API_KEY=

# Optionnel : surcharger le modèle. Défaut : gemini-3.6-flash
# Le palier gratuit ne donne accès qu'aux modèles Flash.
# CAVE_SCAN_GEMINI_MODEL=gemini-3.5-flash-lite

# --- Backend PAYANT : Anthropic (--backend anthropic) ----------------------
# ~0,06 € par bouteille. À utiliser pour le chiffre de référence de la v0 :
# un plancher mesuré avec un petit modèle sous-estime la technologie (0040).
# ANTHROPIC_API_KEY=sk-ant-...

# Optionnel : surcharger le modèle. Défaut : claude-opus-5
# CAVE_SCAN_MODEL=claude-sonnet-5
