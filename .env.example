# Copier ce fichier en .env (jamais versionné), puis renseigner.
# Lu par run_v0.py ET inventaire.py ; une variable déjà définie dans
# l'environnement l'emporte sur ce fichier.

# --- Modèle vision -------------------------------------------------------------
# Backend par défaut (--backend gemini, palier gratuit) : clé Google AI Studio.
GEMINI_API_KEY=
# Autre modèle Gemini (défaut : gemini-3.6-flash).
# CAVE_SCAN_GEMINI_MODEL=

# Backend payant (--backend anthropic).
# ANTHROPIC_API_KEY=
# CAVE_SCAN_MODEL=

# --- Données --------------------------------------------------------------------
# Base : chemin d'un fichier SQLite, ou URL complète (postgresql://...).
# Défaut : data/cave_scan.db
# CAVE_SCAN_DB=
# Photos copiées par l'outil, nommées par leur empreinte. Défaut : data/stockage
# CAVE_SCAN_STOCKAGE=

# --- Écrans ---------------------------------------------------------------------
# Auteur des corrections faites depuis l'écran de relecture, tracé dans
# l'historique (en attendant la connexion). Défaut : Expert
# CAVE_SCAN_AUTEUR=
